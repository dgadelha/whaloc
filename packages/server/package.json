{
	"name": "@whaloc/server",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "whaloc HTTP server: Graph API mock, control-plane API and web UI host",
	"license": "MIT",
	"main": "./dist/main.js",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"dev": "node --watch --experimental-transform-types --disable-warning=ExperimentalWarning --conditions=development src/main.ts",
		"start": "node --disable-warning=ExperimentalWarning dist/main.js",
		"test": "vitest run",
		"test:watch": "vitest watch",
		"typecheck": "tsc"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1124.0",
		"@aws-sdk/lib-storage": "^3.1124.0",
		"@hono/node-server": "^2.1.1",
		"@whaloc/shared": "*",
		"hono": "^4.13.5",
		"kysely": "^0.29.5",
		"pino": "^10.3.1",
		"ws": "^8.21.3",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@types/node": "^24.13.3",
		"@types/ws": "^8.18.1",
		"typescript": "^6.0.3",
		"vitest": "^4.1.11"
	}
}
