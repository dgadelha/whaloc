{
	"name": "@whaloc/server",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "whaloc HTTP server: Graph API mock, control-plane API and web UI host",
	"license": "MIT",
	"main": "./dist/main.js",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"dev": "node --watch --conditions=development src/main.ts",
		"start": "node dist/main.js",
		"test": "vitest run",
		"test:watch": "vitest watch",
		"typecheck": "tsc"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1171.0",
		"@aws-sdk/lib-storage": "^3.1171.0",
		"@hono/node-server": "^2.1.9",
		"@whaloc/shared": "*",
		"hono": "^4.13.19",
		"kysely": "^0.29.9",
		"pino": "^10.4.0",
		"ws": "^8.23.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/node": "^26.6.6",
		"@types/ws": "^8.18.2",
		"typescript": "^6.0.3",
		"vitest": "^5.1.0"
	}
}
