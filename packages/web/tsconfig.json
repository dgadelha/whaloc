{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		// Workspace packages are consumed from source while developing and type checking;
		// the `development` export condition points at `src/`, the default one at `dist/`.
		"customConditions": ["development"],
		"noEmit": true,
		"lib": ["esnext", "dom", "dom.iterable"],
		"types": ["node", "vite/client"],
		"jsx": "react-jsx"
	},
	"include": ["src/**/*", "vite.config.ts", "vitest.config.ts"]
}
